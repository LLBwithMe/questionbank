{
  "subject": "crim_psych",
  "modules": [
    {
      "id": "module_01",
      "code": "01",
      "name": "Introduction to Criminology",
      "description": "Foundations of criminology, its scope, nature, and relationship with other disciplines.",
      "estimatedHours": 2,
      "subTopics": [
        {
          "name": "Meaning & Scope",
          "items": [
            "Definition of criminology",
            "Scope and importance",
            "Relationship with sociology and psychology",
            "Schools of criminology overview"
          ]
        },
        {
          "name": "Classical School",
          "items": [
            "Beccaria's contributions",
            "Bentham's utilitarianism",
            "Deterrence theory",
            "Criticism of classical school"
          ]
        }
      ]
    },
    {
      "id": "module_02",
      "code": "02",
      "name": "Positivist & Biological Theories",
      "description": "Lombroso's born criminal theory, biological and anthropological approaches to crime causation.",
      "estimatedHours": 3,
      "subTopics": [
        {
          "name": "Lombroso's Theory",
          "items": [
            "Atavism and born criminal",
            "Physical stigmata",
            "Types of criminals",
            "Neo-Lombrosian approach"
          ]
        },
        {
          "name": "Biological Theories",
          "items": [
            "Body type theories — Sheldon",
            "XYY chromosome theory",
            "Genetic factors in crime",
            "Criticism of biological determinism"
          ]
        }
      ]
    },
    {
      "id": "module_03",
      "code": "03",
      "name": "Psychological Approaches",
      "description": "Freudian psychoanalysis, personality disorders, and mental illness as factors in criminal behaviour.",
      "estimatedHours": 3,
      "subTopics": [
        {
          "name": "Psychoanalytic Theory",
          "items": [
            "Freud's id, ego, superego",
            "Unconscious motivation",
            "Psychopathy and antisocial personality",
            "Eysenck's theory"
          ]
        },
        {
          "name": "Criminal Profiling",
          "items": [
            "FBI profiling methodology",
            "Organised vs disorganised offenders",
            "Geographical profiling",
            "Limitations of profiling"
          ]
        }
      ]
    },
    {
      "id": "module_04",
      "code": "04",
      "name": "Sociological Theories",
      "description": "Social structure, strain, labelling, and conflict theories explaining criminal behaviour.",
      "estimatedHours": 3,
      "subTopics": [
        {
          "name": "Strain & Anomie",
          "items": [
            "Durkheim's anomie",
            "Merton's strain theory",
            "Modes of adaptation",
            "Institutional anomie theory"
          ]
        },
        {
          "name": "Social Process Theories",
          "items": [
            "Differential association — Sutherland",
            "Labelling theory — Becker",
            "Social control theory — Hirschi",
            "Neutralisation theory"
          ]
        }
      ]
    },
    {
      "id": "module_05",
      "code": "05",
      "name": "Victimology",
      "description": "Study of victims, victim-offender relationships, and victim rights in the criminal justice system.",
      "estimatedHours": 2,
      "subTopics": [
        {
          "name": "Victimology Basics",
          "items": [
            "Definition and scope",
            "Victim precipitation theory",
            "Lifestyle-routine activities theory",
            "Von Hentig's typology of victims"
          ]
        },
        {
          "name": "Victim Rights",
          "items": [
            "Victim compensation schemes",
            "Restorative justice and victims",
            "Witness protection",
            "CCTNS and victim databases"
          ]
        }
      ]
    }
  ]
}