{
  "subject": "ipr",
  "modules": [
    {
      "id": "module_01",
      "code": "01",
      "name": "Introduction to IPR & TRIPS",
      "description": "Nature of intellectual property, international framework, WIPO, and TRIPS Agreement obligations.",
      "estimatedHours": 2,
      "subTopics": [
        {
          "name": "IPR Fundamentals",
          "items": [
            "Meaning and types of IP",
            "Justifications — labour theory, personality theory",
            "IPR and development",
            "IP as intangible property"
          ]
        },
        {
          "name": "International Framework",
          "items": [
            "Paris Convention 1883",
            "Berne Convention 1886",
            "WIPO — structure and role",
            "TRIPS Agreement — India's compliance"
          ]
        }
      ]
    },
    {
      "id": "module_02",
      "code": "02",
      "name": "Patent Law",
      "description": "Patentability criteria, procedure for grant, compulsory licensing, and patent infringement.",
      "estimatedHours": 3,
      "subTopics": [
        {
          "name": "Patents Act 1970",
          "items": [
            "Patentable and non-patentable inventions",
            "Novelty, inventive step, industrial applicability",
            "Section 3(d) — Novartis case",
            "Product vs process patent"
          ]
        },
        {
          "name": "Patent Procedure",
          "items": [
            "Application and examination",
            "Publication and opposition",
            "Grant and term of patent",
            "Compulsory licensing — Section 84",
            "Revocation of patents"
          ]
        }
      ]
    },
    {
      "id": "module_03",
      "code": "03",
      "name": "Copyright Law",
      "description": "Original works, authorship, ownership, fair dealing, moral rights, and copyright infringement.",
      "estimatedHours": 3,
      "subTopics": [
        {
          "name": "Copyright Act 1957",
          "items": [
            "Original literary, dramatic, musical, artistic works",
            "Authorship and ownership",
            "Term of copyright",
            "Assignment and licensing"
          ]
        },
        {
          "name": "Infringement & Defences",
          "items": [
            "Direct and contributory infringement",
            "Fair dealing — Section 52",
            "Moral rights of author",
            "Remedies for infringement"
          ]
        }
      ]
    },
    {
      "id": "module_04",
      "code": "04",
      "name": "Trademark Law",
      "description": "Registration, distinctiveness, well-known marks, passing off, and trademark infringement.",
      "estimatedHours": 2,
      "subTopics": [
        {
          "name": "Trademarks Act 1999",
          "items": [
            "Absolute and relative grounds for refusal",
            "Registration procedure and opposition",
            "Well-known trade marks",
            "Madrid Protocol"
          ]
        }
      ]
    },
    {
      "id": "module_05",
      "code": "05",
      "name": "Designs & Geographical Indications",
      "description": "Designs Act 2000, registration of designs, GI Act 1999, and Darjeeling tea as GI case study.",
      "estimatedHours": 2,
      "subTopics": [
        {
          "name": "Designs Act 2000",
          "items": [
            "Registrability of designs",
            "Procedure for registration",
            "Piracy of registered design",
            "Cancellation of design registration"
          ]
        },
        {
          "name": "Geographical Indications",
          "items": [
            "GI Act 1999",
            "Registration requirements",
            "GI tags in India",
            "Basmati rice, Darjeeling tea disputes"
          ]
        }
      ]
    },
    {
      "id": "module_06",
      "code": "06",
      "name": "Digital IPR & Emerging Issues",
      "description": "Software patents, internet copyright, domain names, and IP in artificial intelligence.",
      "estimatedHours": 2,
      "subTopics": [
        {
          "name": "Digital Copyright",
          "items": [
            "Software as copyright subject matter",
            "Digital Rights Management",
            "Section 65A and 65B — anti-circumvention",
            "Online piracy and intermediary liability"
          ]
        },
        {
          "name": "Emerging Issues",
          "items": [
            "AI-generated works and ownership",
            "Domain name disputes — UDRP",
            "Traditional knowledge protection",
            "Biodiversity and IP — Nagoya Protocol"
          ]
        }
      ]
    }
  ]
}